 "poems": [
  {
   "seq": "1",
   "text": "年每にとまらぬ秋としりなからおしむ心のこりすも有哉",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "おしといひてうみへもさそへ飛渡る何れか秋のわたり成らん",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "あたなりと人やみるらん年每にとまらぬ秋をおしむ心を",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "よそ人も秋はおしきを淺茅生のむへも聲〓〓鹿やなくらむ",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "長月はこしひよりこそおしまるれ今は限の秋とおもへは",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "とふ人もなき物ゆへに味氣なくいはんまもなくおしき秋哉",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "神なひの杜によをへて鳴鹿はすき行秋をおしみとめなん",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "聲たて〓鳴鹿はかりおしめとも過ゆく秋はとまらさり鳬",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "時雨つ〓草はもなへてもみつとも常盤の山に秋はとまれり",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "おしめとも秋はとまらすたつた山紅葉をぬさと究にたむけん",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "秋每に咲すはあらねと女郞花ちりゆく〓とはおしくそ有ける",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "めにみえて別る〓秋を惜めはや大空のみそ眺めらる蘭",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "おしと思ふ心そ深きあまの河なかれて秋のとまる成らん",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "いつくへか秋はゆくらんつの國のなからへ行ときかは賴まむ",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "我宿のきくの花しも紅葉ねは過行秋もあらしとそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "はかなくて過る秋とはしりなからおしむ心のなをあかぬ哉",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "いつこにか秋はいくらん跡をたにとめてゆきをは尋見てまし",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "おほ方の秋はおしめとかひもなしなの長月をと〓めてしかな",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "慕ひてもとめまほしきを今はとて秋の行らんかたそしられぬ",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "紅葉のにしきと見ゆる秋なれはたつをおしとや鹿の鳴らん",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "惜めともとまらぬ秋としりなからまとふ心はいかにせよとか",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "龍田河わたりし秋にあらぬかな流れて紅葉つれにみるへく",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "草村の心しと〓もにそわたるくれはしぬへき秋のおしさに",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "こりすまに逢ひもみる哉女郞花とまらすかへる秋としるらし",
   "kana": "",
   "speaker": "",
   "page": 15,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "我こ〓ろ慰めかねつ身をすて〓おしむを秋のしゐてすくれは",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "紅葉はのはかなき風にちらされは秋は過くともしられさらまし",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "と〓むれと今は限りと行秋のわりなくおしくおもほゆる哉",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "あふ坂の關の紅葉し心あらはくれて行とも秋をとめなん",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "秋すくとねをも鳴哉深草のかけとたのめる虫ならなくに",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "いつかたに心をやらんあかすして過行秋を惜みと〓めて",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "まてといひてとまらぬ秋としりなから空行月のおしくも有哉",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "深山なる紅葉の錦色にいて〓おしむに秋のた〓はうからん",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "暮ぬへき秋をおしめは小倉山みねのもちも色つきにけり",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "おしめとも秋は止らぬ女郞花野へにおくれて枯れぬはかりを",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "紅葉のなかる〓川ををしなへてせきそと〓むる秋のおしさに",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "ちらすなる心のま〓にをのかし〓わかる〓秋をおしみつる哉",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "大空の心そまとふめに見えてわかる〓秋をおしむ我身は",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "止むれととまらぬ秋をおしむとて心にはかるなをやたちなん",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "身にそへてもたらぬ秋をおしむとて暮れむ〓と社侘しかりけれ",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "紅葉つ〓時雨ふりいて〓行秋を峯の朝きり立ちもとめなん",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "今はとて過行秋のかたみには風のをくれに紅葉をや見む",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "穐なからとしはくれなむ紅葉をぬさとちらせる山の峯より",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "おしめともとまらぬ秋はときは山紅葉はてぬと見ても許さし",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "年每にとまらぬ秋と思ひなはてもろき人もおしまさらまし",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "秋といへは今いくたひも殘らぬをおしむ心もともにつきつ〓",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "おしむにもとまらぬ秋の立ゐては恨をのみやおもひ出にせむ",
   "kana": "",
   "speaker": "",
   "page": 16,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
